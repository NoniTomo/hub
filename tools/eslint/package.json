{
  "name": "@nonitomo/eslint",
  "type": "module",
  "version": "0.0.1",
  "description": "eslint config",
  "author": {
    "name": "NoniTomo",
    "url": "https://github.com/NoniTomo/hub"
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/NoniTomo/hub"
  },
  "bugs": {
    "url": "https://github.com/NoniTomo/hub/issues"
  },
  "keywords": [
    "eslint",
    "formatter"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      }
    }
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/esm/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm type && pnpm build",
    "build": "tsdown",
    "lint": "eslint . --fix",
    "lint-inspector": "npx @eslint/config-inspector",
    "type": "tsc --noEmit",
    "format": "prettier --write .",
    "pretty": "pnpm type && pnpm lint && pnpm format"
  },
  "dependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@eslint-react/eslint-plugin": "5.28.8",
    "@vue/compiler-sfc": "3.5.45",
    "eslint": "10.14.0",
    "eslint-flat-config-utils": "3.2.0",
    "oxfmt": "^0.78.0"
  },
  "devDependencies": {
    "@nonitomo/eslint": "0.0.1",
    "@nonitomo/oxfmt": "0.0.1",
    "@nonitomo/tsconfig": "0.0.1"
  }
}
