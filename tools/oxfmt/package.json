{
  "name": "@nonitomo/oxfmt",
  "license": "MIT",
  "type": "module",
  "version": "0.0.1",
  "description": "oxfmt config",
  "keywords": [
    "oxfmt",
    "formatter"
  ],
  "author": {
    "name": "NoniTomo",
    "url": "https://github.com/NoniTomo/hub"
  },
  "repository": {
    "url": "https://github.com/NoniTomo/hub"
  },
  "bugs": {
    "url": "https://github.com/NoniTomo/hub/issues"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      }
    }
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/esm/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm type && pnpm build",
    "build": "tsdown",
    "type": "tsc --noEmit",
    "format": "oxfmt",
    "pretty": "pnpm type && pnpm lint && pnpm format"
  },
  "peerDependencies": {
    "oxfmt": "^0.78.0"
  },
  "dependencies": {
    "oxfmt": "^0.78.0"
  },
  "devDependencies": {
    "@nonitomo/tsconfig": "0.0.1"
  }
}
